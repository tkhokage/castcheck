# Render's free service runs migrations at startup because pre-deploy jobs
# are unavailable. Keep the pinned Prisma CLI in this image for that step.
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --include=dev
COPY . .
RUN node scripts/set-db-provider.mjs postgresql && npx prisma generate
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_CONTACT_EMAIL
ARG NEXT_PUBLIC_SECURITY_EMAIL
RUN npm run build && chown -R node:node /app/.next
ENV NODE_ENV=production
USER node
EXPOSE 10000
CMD ["node", "scripts/render-start.mjs"]
