# Production environment template. Copy values into your host's secret manager —
# never commit a real .env.production. See docs/deployment.md for the full guide.

# --- Database ---------------------------------------------------------------
# Managed PostgreSQL (Neon, Supabase, RDS, Railway…). Keep sslmode=require.
# Also run `npm run db:use:postgres` so Prisma targets Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/castcheck?schema=public&sslmode=require"

# --- Auth (REQUIRED — the app refuses to boot in production without it) ------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_VALUE"

# Keep the demo-account helper OFF in production.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="false"

# --- Transactional email (REQUIRED for password reset / verification) --------
# Sign up for Resend (https://resend.com); verify a domain; paste the API key.
# Without it, reset/verification links are logged instead of emailed.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="CASTCHECK <noreply@yourdomain.com>"
# Public base URL, so email links are absolute (e.g. https://castcheck.vercel.app).
APP_URL="https://yourdomain.com"

# --- Optional -----------------------------------------------------------------
# AI layer. Without it, rule-based fallbacks are used.
ANTHROPIC_API_KEY=""

# NOTE: object-storage and Redis rate-limit variables are added in Phase G4.
