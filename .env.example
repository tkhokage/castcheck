# Copy this file to .env for local development:  cp .env.example .env
# Local development uses SQLite — no database server needed.

# --- Database ---------------------------------------------------------------
# Local dev: SQLite file (created by `npm run db:push`).
DATABASE_URL="file:./dev.db"

# --- Auth -------------------------------------------------------------------
# Secret used to sign session JWTs. Any non-empty value works for local dev.
# Generate a strong value for anything shared or deployed:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-only-change-me"

# --- Optional integrations (all have graceful fallbacks when unset) ---------
# AI layer (opportunity/risk analysis, career fit, ticket triage, contract help).
# Without it, CASTCHECK uses transparent rule-based fallbacks.
ANTHROPIC_API_KEY=""

# Transactional email (password reset, email verification). Without it, the app
# logs the link and shows it in a dev-only banner. See docs/deployment.md.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="CASTCHECK <noreply@localhost>"

# Show the demo-account helper card on the login page (local convenience only).
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="true"
